; minirt.ksasm — runtime mínimo das fases 0–3 do kscc.
;
; Substituído pela libks (lib/libks.kso) na fase 4; o link usa este
; arquivo só enquanto lib/libks.kso não existe. Todas as funções seguem a
; ABI do doc 02: argumentos em r1-r4, retorno em r1, r1-r15 livres,
; fp/sp preservados.
;
;   void ks_sys_exit(int code)                 syscall EXIT
;   int  ks_sys_putc(int c)                    syscall PUTC
;   int  ks_sys_puts(const char *p, int len)   syscall PUTS
;   void ks_put_str(const char *s)             string terminada em '\0'
;   void ks_put_int(int v)                     decimal com sinal
;   void ks_put_uint(unsigned v)               decimal sem sinal
;   void ks_put_hex(unsigned v)                0x + 8 dígitos
;   void ks_assert_eq(int expected, int actual, int line)
;        se diferentes: "assert_eq falhou (linha L): esperado E, obtido A\n"
;        e EXIT 1. Só para os testes unitários desta fase.

        .text

        .global ks_sys_exit
ks_sys_exit:
        syscall EXIT
        halt

        .global ks_sys_putc
ks_sys_putc:
        syscall PUTC
        ret

        .global ks_sys_puts
ks_sys_puts:
        syscall PUTS
        ret

        .global ks_put_str
ks_put_str:
        mov     r5, r1
ks_put_str.len:
        ldb     r6, [r5]
        cmpi    r6, 0
        beq     ks_put_str.out
        inc     r5
        b       ks_put_str.len
ks_put_str.out:
        sub     r2, r5, r1
        syscall PUTS
        ret

        .global ks_put_int
ks_put_int:
        cmpi    r1, 0
        bge     ks_put_uint
        mov     r7, r1
        li      r1, '-'
        syscall PUTC
        neg     r1, r7
        ; continua em ks_put_uint com |v| (INT_MIN vira 2147483648 sem sinal)

        .global ks_put_uint
ks_put_uint:
        subi    sp, sp, 12          ; buffer: 10 dígitos bastam
        addi    r5, sp, 12          ; escreve de trás para frente
        li      r6, 10
ks_put_uint.digit:
        remu    r7, r1, r6
        addi    r7, r7, '0'
        dec     r5
        stb     [r5], r7
        divu    r1, r1, r6
        cmpi    r1, 0
        bne     ks_put_uint.digit
        addi    r2, sp, 12
        sub     r2, r2, r5
        mov     r1, r5
        syscall PUTS
        addi    sp, sp, 12
        ret

        .global ks_put_hex
ks_put_hex:
        mov     r5, r1
        li      r1, '0'
        syscall PUTC
        li      r1, 'x'
        syscall PUTC
        li      r6, 28
ks_put_hex.nibble:
        shr     r1, r5, r6
        andi    r1, r1, 0xF
        cmpi    r1, 10
        blo     ks_put_hex.dec
        addi    r1, r1, 'a' - 10
        b       ks_put_hex.put
ks_put_hex.dec:
        addi    r1, r1, '0'
ks_put_hex.put:
        syscall PUTC
        subi    r6, r6, 4
        bge     ks_put_hex.nibble
        ret

        .global ks_assert_eq
ks_assert_eq:
        cmp     r1, r2
        bne     ks_assert_eq.fail
        ret
ks_assert_eq.fail:
        mov     r16, r1             ; não retorna: pode usar callee-saved
        mov     r17, r2
        mov     r18, r3
        la      r1, ks_assert_eq.s1
        call    ks_put_str
        mov     r1, r18
        call    ks_put_int
        la      r1, ks_assert_eq.s2
        call    ks_put_str
        mov     r1, r16
        call    ks_put_int
        la      r1, ks_assert_eq.s3
        call    ks_put_str
        mov     r1, r17
        call    ks_put_int
        li      r1, '\n'
        syscall PUTC
        li      r1, 1
        syscall EXIT
        halt

        .rodata
ks_assert_eq.s1: .asciz "assert_eq falhou (linha "
ks_assert_eq.s2: .asciz "): esperado "
ks_assert_eq.s3: .asciz ", obtido "
        .text
