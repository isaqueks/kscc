; crt0.ksasm — ponto de entrada de programas C compilados pelo kscc
; (doc 05 §1). O link (src/link.c) coloca este arquivo antes das unidades
; do usuário e acrescenta ".entry _start" no rodapé.
;
; A ksvm2 não tem syscall para argc/argv: main recebe argc = 0, argv = 0.
; Voltar de main equivale a chamar exit com o valor devolvido (C11
; 5.1.2.2.3), então _start chama exit da libks, que roda os handlers de
; atexit e descarrega o buffer de stdout antes da syscall EXIT.

        .text
        .global _start
_start:
        clr     r1                  ; argc = 0
        clr     r2                  ; argv = NULL
        call    main
        call    exit                ; r1 = valor de retorno de main
        halt                        ; não alcançado
