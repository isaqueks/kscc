; test/embedded/gpio.ksasm — wrappers de syscall de GPIO e tempo (doc 02
; §6, grupos 0, 2 e 4 do doc 06 da ksvm2), para os programas embarcados
; enquanto o runtime (lib/minirt.ksasm) não os tem. Quando a libks tiver
; ks_sys_pin_mode & cia. (doc 05 §1), test/embedded/run.sh deixa de passar
; este arquivo ao kscc (senão os símbolos ficariam duplicados no link).
;
;   int      ks_sys_caps(int n)                 1 se a syscall n existe
;   int      ks_sys_pin_mode(int pin, int mode) 0 ok, -1 erro
;   int      ks_sys_pin_write(int pin, int v)
;   int      ks_sys_pin_read(int pin)
;   int      ks_sys_sleep_ms(unsigned ms)
;   unsigned ks_sys_millis(void)
;
; Argumentos já estão em r1/r2 (ABI do kscc = convenção das syscalls).

        .text

        .global ks_sys_caps
ks_sys_caps:
        syscall CAPS
        ret

        .global ks_sys_pin_mode
ks_sys_pin_mode:
        syscall PIN_MODE
        ret

        .global ks_sys_pin_write
ks_sys_pin_write:
        syscall PIN_WRITE
        ret

        .global ks_sys_pin_read
ks_sys_pin_read:
        syscall PIN_READ
        ret

        .global ks_sys_sleep_ms
ks_sys_sleep_ms:
        syscall SLEEP_MS
        ret

        .global ks_sys_millis
ks_sys_millis:
        syscall MILLIS
        ret
